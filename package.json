{
  "name": "futureskilz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run src/server/capture/capture.integration.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/server/db/seed/run.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.186.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.30.0",
    "mammoth": "^1.13.0",
    "mysql2": "^3.23.2",
    "next": "16.3.0",
    "nodemailer": "^10.1.2",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
