# Local XAMPP MariaDB. Replace with Hostinger hPanel values in production.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=futureskilz
MYSQL_PASSWORD=futureskilz_local_dev
MYSQL_DATABASE=futureskilz
MYSQL_CONNECTION_LIMIT=10

# Provider selection. Deterministic fallbacks work without credentials.
AI_PROVIDER=deterministic
OPENAI_API_KEY=
XAI_API_KEY=
STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=console

# Required outside local development. Use independent long random values.
SESSION_SECRET=replace-with-at-least-32-characters
MAGIC_LINK_SECRET=replace-with-at-least-32-characters
